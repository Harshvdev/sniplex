{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "sniplex",
  "version": "0.1.0",
  "identifier": "com.sniplex.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sniplex",
        "width": 1100,
        "height": 720,
        "minWidth": 700,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "maximized": true
      },
      {
        "label": "overlay",
        "title": "Sniplex Capture Overlay",
        "url": "index.html#overlay",
        "fullscreen": true,
        "decorations": false,
        "alwaysOnTop": true,
        "visible": false,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Modern desktop screen capture and markup utility",
    "longDescription": "Sniplex is a modern, high-performance desktop screen capture, recording, and markup utility built with the Fluent design system."
  }
}
